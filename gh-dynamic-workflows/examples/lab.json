{
  "schemaVersion": 1,
  "profile": "azure-lab",
  "terraformPolicy": {
    "requirement": "any",
    "preference": "avm"
  },
  "projectRoot": ".",
  "repositories": [
    {
      "id": "app",
      "path": ".",
      "access": "write",
      "scope": ["src", "test", "scripts/lab", "docs", "README.md"]
    }
  ],
  "specification": {
    "repository": "app",
    "path": "docs/REPLACE-WITH-REAL-SPEC.md"
  },
  "acceptance": [
    {
      "id": "replace-with-real-local-criterion",
      "criterion": "REPLACE with a concrete product criterion proven by actual local tests and build artifacts.",
      "level": "local"
    }
  ],
  "authorization": {
    "acknowledgement": "I authorize the explicitly selected nonproduction lab capabilities",
    "localExecution": true,
    "directSdkDispatch": true,
    "provision": false,
    "providerRegistration": false,
    "publish": false,
    "repositoryCreation": false,
    "modelTests": false
  },
  "target": {
    "id": "replace-with-real-lab-target",
    "environment": "test",
    "deploy": false,
    "requirePublication": false
  },
  "azure": {
    "subscriptionId": "REPLACE-WITH-AUTHORIZED-SUBSCRIPTION-ID",
    "tenantId": "REPLACE-WITH-AUTHORIZED-TENANT-ID",
    "region": "REPLACE-WITH-APPROVED-REGION",
    "profile": {
      "repository": "app",
      "path": ".azure/lab-profile"
    },
    "providers": [],
    "models": []
  },
  "commands": {
    "preflight": [
      {
        "repository": "app",
        "executable": "node",
        "script": "scripts/lab/REPLACE-offline-preflight.mjs",
        "args": [],
        "cwd": ".",
        "timeoutMs": 120000,
        "dependencies": []
      }
    ],
    "baseline": [
      {
        "repository": "app",
        "executable": "node",
        "script": "scripts/lab/REPLACE-baseline.mjs",
        "args": [],
        "cwd": ".",
        "timeoutMs": 120000,
        "dependencies": []
      }
    ],
    "test": [
      {
        "repository": "app",
        "executable": "node",
        "script": "scripts/lab/REPLACE-test.mjs",
        "args": [],
        "cwd": ".",
        "timeoutMs": 120000,
        "dependencies": []
      }
    ],
    "build": [
      {
        "repository": "app",
        "executable": "node",
        "script": "scripts/lab/REPLACE-build.mjs",
        "args": [],
        "cwd": ".",
        "timeoutMs": 120000,
        "dependencies": []
      }
    ]
  },
  "bootstrapPaths": [
    {"repository": "app", "paths": ["scripts/lab/bootstrap"]}
  ],
  "documentationPaths": [
    {"repository": "app", "paths": ["docs/RELEASE-NOTES.md", "README.md"]}
  ],
  "ownerContracts": [],
  "attempts": {
    "planning": 2,
    "implementation": 2,
    "repair": 1,
    "recovery": 2
  },
  "maxSprints": 2
}
